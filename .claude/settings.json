{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-repo:*)",
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/secrets.json)",
      "Read(**/UserSecrets/**)"
    ]
  }
}
